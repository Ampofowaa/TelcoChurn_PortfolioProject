# Normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly binary — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.parquet binary
*.csv binary

# Language bar: count the code, not notebook outputs (mostly embedded plot images),
# and count the SQL feature views, which GitHub ignores by default
*.ipynb linguist-detectable=false
*.sql linguist-detectable=true
*.mako linguist-generated
