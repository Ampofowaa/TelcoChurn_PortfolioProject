# Copy this file to .env and fill in your values.
# Never commit .env to git.
# Values do not need quotes unless they contain spaces or special characters.

# Postgres (Phase 1+)
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password  # pragma: allowlist secret
POSTGRES_DB=your-db-name
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://your-db-user:your-db-password@localhost:5432/your-db-name  # pragma: allowlist secret

# Logging (Phase 0+) — 'console' (human-readable, default) or 'json' (CloudWatch/Grafana, Phase 12+)
LOG_FORMAT=console

# MLflow (Phase 5+)
MLFLOW_TRACKING_URI=http://localhost:5000

# Prefect (Phase 10+)
PREFECT_API_URL=http://localhost:4200/api

# AWS (Phase 12+)
AWS_REGION=us-east-1
# Only uncomment and fill these in if you're not already authenticated via
# `aws configure`/SSO/an instance role. Leaving them uncommented with the
# literal placeholder text below is worse than not having this file at all:
# load_dotenv()'s default override=False only skips a key that's ALREADY set
# in the OS environment, so if your shell has no real AWS_ACCESS_KEY_ID
# exported, python-dotenv injects this placeholder string into the process
# env instead — and boto3 prefers env vars over ~/.aws/credentials, so it
# uses the placeholder and fails with InvalidAccessKeyId rather than falling
# through to your real, working credentials.
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key  # pragma: allowlist secret

# Serving API key (Phase 9+) — only read when configs/serving/api.yaml's
# auth.enabled is true (off by default). Required, not optional, whenever
# that flag is on: serving/app.py refuses to start otherwise.
API_KEY=your-api-key  # pragma: allowlist secret

# Docker Compose port overrides (Phase 9+) — host-side ports for the fastapi
# and streamlit services; defaults match the values below if unset.
API_PORT=8000
STREAMLIT_PORT=8501
