# Add patterns of files dvc should ignore, which could improve
# the performance. Learn more at
# https://dvc.org/doc/user-guide/dvcignore

# Human-only dumps and the MLflow artifact store — never DVC-tracked outs,
# so excluding them keeps DAG traversal/workspace scans from walking them.
reports/figures/
reports/validation/
reports/feature_discovery/
mlruns/

# Compiled bytecode cache — already gitignored, but DVC hashes the real
# filesystem independently of git, so without this a directory dep like
# src/telco_churn/models/train/ picks up every .pyc regenerated by any
# Python process that imports it and reruns the stage for zero source change.
**/__pycache__/
